{
  "name": "CAMXD Dashboard Admin",
  "short_name": "CAMXD Admin",
  "description": "Dashboard Admin CAMXD Store",
  "id": "./camxd-admin-app",
  "start_url": "./admin.html?app=camxd-admin",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait-primary",
  "background_color": "#050505",
  "theme_color": "#ffd000",
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "./camxd-admin-icon.svg",
      "sizes": "192x192",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "./camxd-admin-icon.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ]
}